{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@gla/shared": ["packages/shared/src/index.ts"],
      "@gla/shared/server": ["packages/shared/src/server.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tools/**/*.ts", "tests/**/*.ts"]
}
